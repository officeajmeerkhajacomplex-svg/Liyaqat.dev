{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLast": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "An AI chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "content", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved Quran Ayah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "surahNumber": { "type": "number" },
        "ayahNumber": { "type": "number" },
        "surahName": { "type": "string" },
        "text": { "type": "string" },
        "translation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "surahNumber", "ayahNumber", "createdAt"]
    },
    "TasbeehSession": {
      "title": "Tasbeeh Session",
      "description": "Record of a completed Dhikr session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "count": { "type": "number" },
        "label": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "count", "label", "timestamp"]
    },
    "PublicProfile": {
      "title": "Public Profile",
      "description": "Publicly readable profile and encryption keys",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "publicKey": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "publicKey"]
    },
    "SocialChat": {
      "title": "Social Chat",
      "description": "Metadata for a direct message or group chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "participants": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "groupImage": { "type": "string" },
        "adminIds": { "type": "array", "items": { "type": "string" } },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "participants", "lastMessageAt", "createdAt"]
    },
    "SocialMessage": {
      "title": "Social Message",
      "description": "An encrypted message in a social chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "encryptedMessage": { "type": "string" },
        "encryptedKeys": { "type": "object" },
        "iv": { "type": "string" },
        "messageType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "seenBy": { "type": "array", "items": { "type": "string" } },
        "replyTo": { "type": "string" }
      },
      "required": ["id", "senderId", "encryptedMessage", "encryptedKeys", "iv", "timestamp", "seenBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/public_profiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Public user profiles with public keys"
    },
    "/social_chats/{chatId}": {
      "schema": "SocialChat",
      "description": "Groups and direct message chats"
    },
    "/social_chats/{chatId}/messages/{messageId}": {
      "schema": "SocialMessage",
      "description": "Encrypted messages within a chat"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "Chat",
      "description": "User's chat sessions"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat session"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User's bookmarked ayahs"
    },
    "/users/{userId}/tasbeeh_history/{historyId}": {
      "schema": "TasbeehSession",
      "description": "User's completed Dhikr sessions"
    }
  }
}
