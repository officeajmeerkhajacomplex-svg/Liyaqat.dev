rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('displayName', null) == null || data.displayName is string) &&
             (data.get('photoURL', null) == null || data.photoURL is string) &&
             data.createdAt == request.time;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt']) &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == request.time;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['userId', 'surahNumber', 'ayahNumber', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidTasbeeh(data) {
      return data.keys().hasAll(['userId', 'count', 'label', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.count is number &&
             data.label is string && data.label.size() <= 100 &&
             data.timestamp == request.time;
    }

    // --- Collections ---

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt;
      
      match /chats/{chatId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChat(incoming());
        allow update: if isOwner(userId) && 
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(incoming());
        }
      }

      match /bookmarks/{bookmarkId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBookmark(incoming());
        allow delete: if isOwner(userId);
      }

      match /tasbeeh_history/{historyId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTasbeeh(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
