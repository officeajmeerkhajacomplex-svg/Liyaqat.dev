rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('displayName', null) == null || data.displayName is string) &&
             (data.get('photoURL', null) == null || data.photoURL is string) &&
             data.createdAt == request.time;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt']) &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == request.time;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['userId', 'surahNumber', 'ayahNumber', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidTasbeeh(data) {
      return data.keys().hasAll(['userId', 'count', 'label', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.count is number &&
             data.label is string && data.label.size() <= 100 &&
             data.timestamp == request.time;
    }

    function isValidPrayerSettings(data) {
      return data.keys().hasAll(['fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'adhanVoice', 'calculationMethod']) &&
             data.fajr is bool &&
             data.adhanVoice is string && data.adhanVoice.size() <= 50 &&
             data.calculationMethod is number;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'publicKey']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.username is string && data.username.size() <= 100 &&
             data.publicKey is string && data.publicKey.size() <= 5000 &&
             (data.get('photoURL', null) == null || data.photoURL is string) &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time) &&
             (data.get('isOnline', null) == null || data.isOnline is bool) &&
             (data.get('lastSeen', null) == null || data.lastSeen == request.time) &&
             (data.get('typingTo', null) == null || data.typingTo is string) &&
             (data.get('fcmToken', null) == null || data.fcmToken is string);
    }

    function isValidSocialChat(data) {
      return data.keys().hasAll(['type', 'participants', 'lastMessageAt', 'createdAt']) &&
             data.type in ['direct', 'group'] &&
             data.participants is list && data.participants.size() > 0 && data.participants.size() <= 100 &&
             request.auth.uid in data.participants &&
             (data.get('name', null) == null || data.name is string) &&
             (data.get('groupImage', null) == null || data.groupImage is string) &&
             (data.get('adminIds', null) == null || data.adminIds is list) &&
             data.createdAt == request.time;
    }

    function isChatParticipant(chatId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/social_chats/$(chatId)).data.participants;
    }

    function isValidSocialMessage(data) {
      return data.keys().hasAll(['senderId', 'encryptedMessage', 'encryptedKeys', 'iv', 'timestamp', 'seenBy']) &&
             data.senderId == request.auth.uid &&
             data.encryptedMessage is string && data.encryptedMessage.size() <= 20000 &&
             data.encryptedKeys is map && data.encryptedKeys.size() <= 100 &&
             data.iv is string && data.iv.size() <= 100 &&
             data.timestamp == request.time &&
             data.seenBy is list && data.seenBy.size() <= 100 &&
             (data.get('replyTo', null) == null || data.replyTo is string) &&
             (data.get('messageType', null) == null || data.messageType is string) &&
             (data.get('isDeleted', null) == null || data.isDeleted is bool) &&
             (data.get('reactions', null) == null || data.reactions is map);
    }

    // --- Collections ---

    match /test/connection {
      allow get: if true;
    }

    match /public_profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidPublicProfile(incoming());
      allow update: if isOwner(userId) && 
                      incoming().uid == existing().uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'photoURL', 'publicKey', 'updatedAt', 'isOnline', 'lastSeen', 'typingTo', 'fcmToken']);
    }

    match /social_chats/{chatId} {
      allow get: if isSignedIn() && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isSignedIn() && isValidSocialChat(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'name', 'groupImage', 'participants', 'adminIds']);
      allow delete: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{messageId} {
        allow get: if isChatParticipant(chatId);
        allow list: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && isValidSocialMessage(incoming());
        allow update: if isSignedIn() && (
          // Anyone in chat can update seenBy and reactions
          (isChatParticipant(chatId) && incoming().diff(existing()).affectedKeys().hasOnly(['seenBy', 'reactions'])) ||
          // Only sender can delete (update isDeleted)
          (request.auth.uid == existing().senderId && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted']))
        );
        allow delete: if isSignedIn() && request.auth.uid == existing().senderId;
      }
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt;
      
      match /chats/{chatId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChat(incoming());
        allow update: if isOwner(userId) && 
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(incoming());
        }
      }

      match /bookmarks/{bookmarkId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBookmark(incoming());
        allow delete: if isOwner(userId);
      }

      match /tasbeeh_history/{historyId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTasbeeh(incoming());
        allow delete: if isOwner(userId);
      }

      match /prayer_settings/{settingId} {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPrayerSettings(incoming());
      }
    }
  }
}
